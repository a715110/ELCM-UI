<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging configuration for the JSF/PrimeFaces UIs (ecws-ui and elcm-ui).

  Location: each UI's src/main/resources/logback-spring.xml. The file is IDENTICAL
  for both UIs (the log file name comes from spring.application.name). It overrides
  the service version shipped in baseline-common because the app's own copy wins.
  Make sure no plain logback.xml exists: Spring Boot picks it before logback-spring.xml.

  Same rules as the service version, plus the UI-specific library levels
  (PrimeFaces, Weld/JBoss, Tomcat/Apache, Rewrite, JODConverter).

  Profiles:
    local  -> console + rolling file, root DEBUG (as before), DEBUG for com.dodaso
    other  -> console only (containers collect stdout), INFO everywhere
-->
<configuration>

  <!-- Spring's defaults: defines LOG_LEVEL_PATTERN from logging.pattern.level.
       console-appender.xml is NOT included: it defined the unused CONSOLE appender
       that caused "Appender named [CONSOLE] not referenced". -->
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

  <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="dodaso-ui"/>
  <springProperty scope="context" name="LOG_DIR" source="logging.file.path" defaultValue="/development/logs"/>

  <!-- ${LOG_LEVEL_PATTERN} renders level + customer code, e.g. "INFO [acme]" (SDS Step 1 R7) -->
  <property name="DODASO_PATTERN"
    value="%d{yyyy-MM-dd_HH:mm:ss.SSS} ${LOG_LEVEL_PATTERN:-%5p} [%thread] %logger{36} - %msg%n"/>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>${DODASO_PATTERN}</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <!-- Library levels (all profiles). No appender-refs / additivity="false":
       everything flows to the root appenders chosen per profile below. -->
  <!-- Was ERROR. WARN keeps Spring Security and configuration warnings visible. -->
  <logger name="org.springframework" level="WARN"/>
  <logger name="org.springframework.security.web" level="WARN"/>
  <logger name="org.primefaces" level="ERROR"/>
  <logger name="org.jboss" level="ERROR"/>
  <logger name="org.apache" level="ERROR"/>
  <logger name="com.netflix" level="ERROR"/>
  <logger name="org.ocpsoft.rewrite" level="ERROR"/>
  <logger name="org.jodconverter" level="OFF"/>

  <springProfile name="local">
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
      <file>${LOG_DIR}/${APP_NAME}.log</file>
      <encoder>
        <pattern>${DODASO_PATTERN}</pattern>
        <charset>UTF-8</charset>
      </encoder>
      <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
        <fileNamePattern>${LOG_DIR}/archived/${APP_NAME}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
        <maxFileSize>200MB</maxFileSize>      <!-- per archived file -->
        <maxHistory>60</maxHistory>           <!-- days kept -->
        <totalSizeCap>30GB</totalSizeCap>     <!-- oldest archives deleted beyond this -->
      </rollingPolicy>
    </appender>

    <logger name="com.dodaso.ecosystem" level="DEBUG"/>

    <!-- Root stays DEBUG locally, as in the previous file -->
    <root level="DEBUG">
      <appender-ref ref="CONSOLE"/>
      <appender-ref ref="FILE"/>
    </root>
  </springProfile>

  <!-- Every non-local profile, including "cloud". The old block listed
       adev,bdev,dit,sit,uat,prod, which "cloud" never matched: a customer
       instance would have had no appenders and written no logs at all. -->
  <springProfile name="!local">
    <logger name="com.dodaso.ecosystem" level="INFO"/>

    <root level="INFO">
      <appender-ref ref="CONSOLE"/>
    </root>
  </springProfile>

</configuration>